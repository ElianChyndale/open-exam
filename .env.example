# Local mode is the default and requires no remote services.
OPENEXAM_MODE=local

# Set OPENEXAM_MODE=supabase to activate explicit SaaS transfers and API JWT checks.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Browser-safe SSR values. Never expose SUPABASE_SERVICE_ROLE_KEY.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
